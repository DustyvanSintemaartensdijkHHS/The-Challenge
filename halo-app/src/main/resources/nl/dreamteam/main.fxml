<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Rectangle2D?>
<?import javafx.scene.image.*?>
<?import javafx.scene.paint.ImagePattern?>

<!-- Designed with FXForge. fxforge-meta theme="Graphite" accent="" font="System" -->

<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nl.dreamteam.userdashcontroller" stylesheets="@theme.css" prefHeight="780" prefWidth="1240">
    <children>
        <VBox HBox.hgrow="ALWAYS" spacing="20" style="-fx-padding: 28;">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <children>
                        <VBox spacing="2">
                            <children>
                                <Label text="Dashboard" styleClass="h2" />
                                <Label text="Welkom terug, Jane — dit gebeurt er vandaag." styleClass="muted" />
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" maxWidth="25" />
                        <Label text="Prullenbak" styleClass="h3" />
                        <Button fx:id="button1" text="Verbind" onAction="#verbindKnopGeklikt" styleClass="btn-primary,btn-pill" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="label1" text="JD" onMouseClicked="#profielKnopGeklikt" contentDisplay="GRAPHIC_ONLY" styleClass="h1,chip">
                            <properties fxfImage="images/user.png" />
                            <graphic>
                                <Rectangle width="38" height="38" arcWidth="38" arcHeight="38">
                                    <fill>
                                        <ImagePattern x="0" y="0" width="1" height="1" proportional="true">
                                            <image>
                                                <Image url="@images/user.png" />
                                            </image>
                                        </ImagePattern>
                                    </fill>
                                </Rectangle>
                            </graphic>
                        </Label>
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <children>
                        <VBox HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="6" styleClass="card" style="-fx-padding: 18;">
                            <children>
                                <Label text="Punten" styleClass="muted" />
                                <Label text="48.210" styleClass="stat-value" />
                            </children>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="6" styleClass="card" style="-fx-padding: 18;">
                            <children>
                                <Label text="Level" styleClass="muted" />
                                <Label text="5" styleClass="stat-value" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <HBox VBox.vgrow="ALWAYS" alignment="CENTER_LEFT" spacing="16">
                    <children>
                        <VBox HBox.hgrow="ALWAYS" spacing="12" styleClass="card">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <children>
                                        <Label text="Recente interacties" styleClass="h3" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button text="Alles bekijken" styleClass="btn-ghost,btn-sm" />
                                    </children>
                                </HBox>
                                <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS">
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    <columns>
                                        <TableColumn text="EventID" />
                                        <TableColumn text="Soort" />
                                        <TableColumn text="Punten" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>
                        <VBox prefWidth="300" spacing="14" styleClass="card">
                            <children>
                                <Label text="Doelen" styleClass="h3" />
                                <VBox spacing="6">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="8">
                                            <children>
                                                <Label text="Punten" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label text="72%" styleClass="muted" />
                                            </children>
                                        </HBox>
                                        <ProgressBar maxWidth="Infinity" progress="0.72" />
                                    </children>
                                </VBox>
                                <VBox spacing="6">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="8">
                                            <children>
                                                <Label text="Leaderboard" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label text="45%" styleClass="muted" />
                                            </children>
                                        </HBox>
                                        <ProgressBar maxWidth="Infinity" progress="0.45" />
                                    </children>
                                </VBox>
                                <VBox spacing="6">
                                    <children>
                                        <ProgressBar maxWidth="Infinity" progress="0.9" />
                                    </children>
                                </VBox>
                                <Separator />
                                <Label text="Leaderboard" styleClass="h3" />
                                <ListView fx:id="activityList" VBox.vgrow="ALWAYS">
                                    <items>
                                        <FXCollections fx:factory="observableArrayList">
                                            <String fx:value="1." />
                                            <String fx:value="2." />
                                            <String fx:value="3." />
                                            <String fx:value="4." />
                                        </FXCollections>
                                    </items>
                                </ListView>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</HBox>
